# PingQue works with zero configuration using an in-memory store (single server
# process, data lost on restart). To use Supabase instead, set both variables
# below and apply supabase/migrations/*.sql to the project.
#
# These are server-only secrets: never prefix them with NEXT_PUBLIC_ and never
# commit a real .env file.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase service-role key (server only; bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Optional override: "memory" or "supabase". If unset, Supabase is used only
# when both variables above are set.
PINGQUE_STORE=

# Optional: public origin used for the host's QR code and join link, e.g.
# https://pingque.example.com or https://<random>.trycloudflare.com (no path).
# When unset, the origin in the host's address bar is used. In `next dev`, its
# hostname is also added to allowedDevOrigins automatically.
PUBLIC_ORIGIN=

# Optional, dev server only: extra comma-separated hostnames (no scheme/port,
# `*` = one label) allowed to load dev assets, e.g. my-tunnel.example.com,*.ngrok-free.app
ALLOWED_DEV_ORIGINS=
